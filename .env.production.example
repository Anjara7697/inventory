# Copy to .env.production on the server and fill in every value.
#   cp .env.production.example .env.production && nano .env.production
# Generate each secret with:  openssl rand -hex 32   (hex: safe inside the database URL)
# Never commit .env.production (it is in .gitignore).

# Domain pointing to the VPS (DNS "A" record), without https://
DOMAIN=inventory.mondomaine.com

# Database password (use openssl rand -hex 32: it is put in a URL)
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-long

# Login token secrets: two different long random strings
JWT_ACCESS_SECRET=remplacer-par-openssl-rand
JWT_REFRESH_SECRET=remplacer-par-une-autre-valeur-openssl-rand

# First administrator account, created on the first start only
SEED_ADMIN_EMAIL=admin@mondomaine.com
SEED_ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-fort

# true = load the "Pantalon Jean" demo data (leave false in production)
SEED_DEMO=false

# Currency shown in the interface (ISO 4217 code, display only)
CURRENCY=MGA
