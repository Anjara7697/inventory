# Reverse proxy + automatic HTTPS (Let's Encrypt). DOMAIN comes from .env.production.
{$DOMAIN} {
	encode zstd gzip

	# API: /api/products -> backend /products (prefix stripped)
	handle_path /api/* {
		reverse_proxy backend:3001
	}

	# Everything else: the Next.js interface
	handle {
		reverse_proxy frontend:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
